  // ===========================================
  // TABLES
  // ===========================================
  "Table Simple": {
    "prefix": "table",
    "body": [
      "| ${1:Header 1} | ${2:Header 2} | ${3:Header 3} |",
      "|----------|----------|----------|",
      "| ${4:Cell 1} | ${5:Cell 2} | ${6:Cell 3} |",
      "| ${7:Cell 4} | ${8:Cell 5} | ${9:Cell 6} |"
    ],
    "description": "Simple markdown table"
  },
  "Table with Caption": {
    "prefix": "tablecap",
    "body": [
      "| ${1:Header 1} | ${2:Header 2} |",
      "|----------|----------|",
      "| ${3:Cell 1} | ${4:Cell 2} |",
      "",
      ": ${5:Table caption} {#tbl-${6:label}}"
    ],
    "description": "Table with caption and label"
  },

  // ===========================================
  // IMAGES
  // ===========================================
  "Image Basic": {
    "prefix": "img",
    "body": "![${1:Alt text}](${2:image.png}){width=\"${3:80%}\"}",
